<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sheep Kingdom 3D</title>
    <!-- Direct linked style.css -->
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div id="ui-container">
        <h1>SHEEP KINGDOM 3D</h1>
        <p>Tap a sheep to clear the field!</p>
        <div id="score">Remaining: <span id="sheep-count">0</span></div>
    </div>

    <div id="win-screen" class="hidden">
        <h2>🎉 LEVEL COMPLETE! 🎉</h2>
        <p>All sheep escaped safely!</p>
        <button onclick="location.reload()">Play Next Level</button>
    </div>

    <!-- Three.js Engine Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
    
    <!-- Direct linked script.js -->
    <script src="script.js"></script>
</body>
</html>

